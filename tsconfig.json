{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "wysiwyg": ["./src/index.ts"],
      "wysiwyg/ui": ["./src/ui/index.ts"]
    }
  },
  "include": ["src", "demo"]
}
